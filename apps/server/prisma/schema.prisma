// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Maps to Role enumeration in CD-1
enum Role {
  OWNER
  EDITOR
  VIEWER
}

// Maps to User entity in CD-1 (FR-07.1 to FR-07.4)
model User {
  username       String              @id
  passwordHash   String
  failedAttempts Int                 @default(0)
  firstFailedAt  DateTime?           // Tracks the 15-minute window for FR-07.4
  lockedUntil    DateTime?           // Set to now + 15m after 5 failures (FR-07.4)
  cloudCredential CloudCredential?
  sessions       Session[]
  memberships    ProjectMembership[]
}

// Maps to Session entity in CD-1 (FR-07.5)
model Session {
  token        String   @id
  username     String
  user         User     @relation(fields: [username], references: [username], onDelete: Cascade)
  lastActivity DateTime @default(now())
}

// Maps to Project entity in CD-1 (FR-01.1, FR-01.4)
model Project {
  id            String              @id @default(uuid())
  name          String
  mainFile      String              @default("main.tex")
  sizeBytes     Int                 @default(0)
  hasServerCopy Boolean             @default(true)
  memberships   ProjectMembership[]

  @@index([name])
}

// Maps to ProjectMembership association class in CD-1 (FR-01.5, FR-01.6)
model ProjectMembership {
  id        String  @id @default(uuid())
  role      Role
  username  String
  projectId String
  user      User    @relation(fields: [username], references: [username], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([username, projectId])
}

model CloudCredential {
  username String @id
  user User @relation(fields: [username], references: [username], onDelete: Cascade)
  provider String
  endpoint String
  model String
  encryptedKey String
}
