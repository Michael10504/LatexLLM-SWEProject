DATABASE_URL="file:./dev.db"
HOST=127.0.0.1
PORT=3443
# Explicit demo mode only. Returns a clearly labelled fixture, not an AI summary.
CLOUD_SUMMARY_STUB=0
# A real provider must accept POST application/pdf and return {"summary":"..."}.
# Inject CLOUD_SUMMARY_API_KEY securely in the server environment; never in the desktop client.
CLOUD_SUMMARY_ENDPOINT=
CLOUD_SUMMARY_API_KEY=
CREDENTIAL_MASTER_SECRET=
# Optional trusted TLS certificate paths (external deployments must use HTTPS).
TLS_KEY_PATH=
TLS_CERT_PATH=
