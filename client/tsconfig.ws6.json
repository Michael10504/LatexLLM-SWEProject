{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "jest"]
  },
  "include": [
    "src/index.ts",
    "src/auth/**/*",
    "src/network/**/*",
    "src/privacy/**/*",
    "src/summarization/**/*",
    "src/ui/**/*",
    "tests/**/*"
  ]
}