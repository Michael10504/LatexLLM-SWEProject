{
  "name": "latex-llm-editor",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main/main.js",
  "scripts": {
    "build:tsc": "tsc",
    "build:renderer": "esbuild src/renderer/renderer.ts --bundle --platform=browser --format=iife --outfile=dist/renderer/renderer.js",
    "build:assets": "copyfiles -u 1 \"src/**/*.html\" \"src/**/*.css\" dist/",
    "build": "npm run build:tsc && npm run build:renderer && npm run build:assets",
    "start": "npm run build && electron .",
    "dev": "concurrently \"tsc -w\" \"npm run build:renderer -- --watch\" \"npm run build:assets\" \"electron .\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Michael10504/LatexLLM-SWEProject.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Michael10504/LatexLLM-SWEProject/issues"
  },
  "homepage": "https://github.com/Michael10504/LatexLLM-SWEProject#readme",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "copyfiles": "^2.4.1",
    "electron": "^45.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "better-sqlite3": "^13.0.3",
    "codemirror": "^6.0.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
